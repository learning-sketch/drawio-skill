<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="dspark-pp" name="PP感知Context累加">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="640" math="0" shadow="0" background="#faf6ee">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;方案设计：PP 感知的 DSpark Context 累加&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#16418c;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1380" height="38" as="geometry"/>
        </mxCell>

        <!-- (1) 核心思想 -->
        <mxCell id="p1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="920" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="p1_h" value="&lt;b&gt;(1)　核心思想&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="p1">
          <mxGeometry x="14" y="8" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="p1_box" value="&lt;font face=&quot;Courier New&quot; color=&quot;#2f5bb7&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;concat(h1..h5) @ W_fc.T　==　sum_i (hi @ Wi.T)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;先在各 PP rank 累加 partial context，&lt;br&gt;只在最后一个 PP rank 做一次 RMSNorm。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fc;strokeColor=#9fb6dd;fontSize=12;fontColor=#1f3864;align=center;verticalAlign=middle;" vertex="1" parent="p1">
          <mxGeometry x="50" y="40" width="820" height="100" as="geometry"/>
        </mxCell>

        <!-- (2) Prefill 侧 PP Pipeline -->
        <mxCell id="p2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="224" width="920" height="216" as="geometry"/>
        </mxCell>
        <mxCell id="p2_h" value="&lt;b&gt;(2)　Prefill 侧 PP Pipeline（新协议）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="p2">
          <mxGeometry x="14" y="8" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="p2_note" value="固定载荷：&lt;font face=&quot;Courier New&quot;&gt;ctx_acc [N, hidden_size]&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#1f3864;" vertex="1" parent="p2">
          <mxGeometry x="440" y="10" width="320" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="pp0" value="&lt;b&gt;PP0&lt;/b&gt;&lt;br&gt;&lt;br&gt;ctx_acc = h1 @ W1.T&lt;br&gt;&lt;br&gt;发送 ctx_acc [N, hidden_size]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8578;fontSize=10.5;fontColor=#1f3864;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="p2">
          <mxGeometry x="14" y="62" width="180" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="pp1" value="&lt;b&gt;PP1&lt;/b&gt;&lt;br&gt;&lt;br&gt;接收 ctx_acc&lt;br&gt;ctx_acc += h2 @ W2.T&lt;br&gt;发送 ctx_acc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8578;fontSize=10.5;fontColor=#1f3864;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="p2">
          <mxGeometry x="242" y="62" width="170" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="ppm" value="&lt;b&gt;中间 PP&lt;/b&gt;&lt;br&gt;&lt;br&gt;ctx_acc += hi @ Wi.T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8578;fontSize=10.5;fontColor=#1f3864;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="p2">
          <mxGeometry x="460" y="62" width="160" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="ppl" value="&lt;b&gt;&lt;font color=&quot;#3d9a50&quot;&gt;最后一层 PP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;接收 ctx_acc&lt;br&gt;ctx_acc += h_last @ W_last.T&lt;br&gt;ctx_norm = RMSNorm(ctx_acc)&lt;br&gt;K,V = KVProj(ctx_norm)&lt;br&gt;写入 draft KV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ed;strokeColor=#82b366;fontSize=10.5;fontColor=#1f3864;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="p2">
          <mxGeometry x="668" y="56" width="238" height="116" as="geometry"/>
        </mxCell>

        <mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2" source="pp0" target="pp1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2" source="pp1" target="ppm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2" source="ppm" target="ppl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p2_foot" value="hi 表示该 rank 本地 feature（示意）" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#8b8577;" vertex="1" parent="p2">
          <mxGeometry x="200" y="182" width="520" height="22" as="geometry"/>
        </mxCell>

        <!-- (3) PD 边界保持不变 -->
        <mxCell id="p3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="454" width="920" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="p3_h" value="&lt;b&gt;(3)　PD 边界保持不变&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="p3">
          <mxGeometry x="14" y="6" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p3_prefill" value="Prefill&#xa;（最后一层 PP 写完 draft KV）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8578;fontSize=10.5;fontColor=#1f3864;" vertex="1" parent="p3">
          <mxGeometry x="14" y="36" width="210" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="p3_decode" value="Decode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8578;fontSize=11.5;fontColor=#1f3864;" vertex="1" parent="p3">
          <mxGeometry x="430" y="38" width="110" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p3_arrow" value="PD 传输" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f3864;strokeWidth=2;fontSize=11;fontColor=#1f3864;labelBackgroundColor=#fdfcf8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3" source="p3_prefill" target="p3_decode">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-9"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_sub" value="target KV + draft KV" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1f3864;" vertex="1" parent="p3">
          <mxGeometry x="240" y="62" width="176" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p3_ok" value="&lt;font style=&quot;font-size:14px&quot;&gt;✅&lt;/font&gt;  仍然不跨 PD 传输 hidden states" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#8b8577;spacingLeft=12;" vertex="1" parent="p3">
          <mxGeometry x="580" y="38" width="330" height="42" as="geometry"/>
        </mxCell>

        <!-- 为什么这样设计 -->
        <mxCell id="why" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="980" y="58" width="440" height="256" as="geometry"/>
        </mxCell>
        <mxCell id="why_h" value="&lt;b&gt;为什么这样设计&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="why">
          <mxGeometry x="14" y="8" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="w1" value="&lt;font style=&quot;font-size:14px&quot;&gt;✅&lt;/font&gt;  保持非 PP 的 DSpark 数学语义" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="why">
          <mxGeometry x="10" y="42" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="&lt;font style=&quot;font-size:14px&quot;&gt;✅&lt;/font&gt;  RMSNorm 仍在完整求和之后" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="why">
          <mxGeometry x="10" y="84" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="w3" value="&lt;font style=&quot;font-size:14px&quot;&gt;✅&lt;/font&gt;  PP 跳数载荷固定为 [N, hidden_size]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="why">
          <mxGeometry x="10" y="126" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="&lt;font style=&quot;font-size:14px&quot;&gt;✅&lt;/font&gt;  避免传输原始 h1..h5" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="why">
          <mxGeometry x="10" y="168" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="w5" value="&lt;font style=&quot;font-size:14px&quot;&gt;✅&lt;/font&gt;  避免错误的本地 KV 注入" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="why">
          <mxGeometry x="10" y="210" width="420" height="34" as="geometry"/>
        </mxCell>

        <!-- 实现要点 -->
        <mxCell id="impl" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="980" y="328" width="440" height="222" as="geometry"/>
        </mxCell>
        <mxCell id="impl_h" value="&lt;b&gt;实现要点&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="impl">
          <mxGeometry x="14" y="8" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="impl_list" value="1)  &lt;font face=&quot;Courier New&quot;&gt;project_target_hidden_partial(…)&lt;/font&gt;&lt;br&gt;&lt;br&gt;2)  扩展 PP proxy：携带 &lt;font face=&quot;Courier New&quot;&gt;dspark_ctx_acc&lt;/font&gt;&lt;br&gt;     （替代/补充 raw aux hidden）&lt;br&gt;&lt;br&gt;3)  最后一层 PP：&lt;br&gt;     &lt;font face=&quot;Courier New&quot;&gt;RMSNorm(ctx_acc) + KVProj&lt;/font&gt; + 写 draft KV" style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1f3864;spacingLeft=16;spacingTop=4;whiteSpace=wrap;" vertex="1" parent="impl">
          <mxGeometry x="10" y="42" width="420" height="168" as="geometry"/>
        </mxCell>

        <!-- Bottom summary -->
        <mxCell id="summary" value="&lt;b&gt;新增通信只发生在 Prefill 的 PP 阶段；Decode 路径不变。&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f2ea;strokeColor=#b9b3a5;fontSize=15;fontColor=#1f3864;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="564" width="1380" height="54" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
