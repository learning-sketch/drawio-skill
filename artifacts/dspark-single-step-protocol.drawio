<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="dspark-step" name="单步协议">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="760" math="0" shadow="0" background="#faf6ee">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;DSpark 单步协议：Draft → Refine → Verify&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#16418c;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="对应 #29538 Worker 层单步执行" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#8b8577;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1380" height="22" as="geometry"/>
        </mxCell>

        <!-- (1) 输入 -->
        <mxCell id="h1" value="&lt;b&gt;(1)　输入&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="inbox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#9fb6dd;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="1380" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="in1" value="•  target fused hidden states" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" vertex="1" parent="inbox">
          <mxGeometry x="24" y="16" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="in2" value="•  bonus token / 当前序列状态" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" vertex="1" parent="inbox">
          <mxGeometry x="262" y="16" width="230" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="in3" value="•  block_size = gamma（默认从 checkpoint 推断）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" vertex="1" parent="inbox">
          <mxGeometry x="516" y="16" width="260" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="in4" value="•  confidence_threshold" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" vertex="1" parent="inbox">
          <mxGeometry x="792" y="16" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="in_sep" value="" style="endArrow=none;html=1;strokeColor=#d8d2c4;" edge="1" parent="inbox">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="8" as="sourcePoint"/>
            <mxPoint x="1060" y="54" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="in_note" value="draft 不靠自己的完整 token KV，&#xa;而靠 target hidden 驱动" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8b8577;spacingLeft=10;" vertex="1" parent="inbox">
          <mxGeometry x="1070" y="8" width="290" height="46" as="geometry"/>
        </mxCell>

        <!-- (2) 主流程 -->
        <mxCell id="h2" value="&lt;b&gt;(2)　主流程&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="200" height="26" as="geometry"/>
        </mxCell>

        <!-- Card 1: Block Draft -->
        <mxCell id="card1" value="&lt;span style=&quot;background-color:#2f5bb7;color:#ffffff;padding:1px 7px;border-radius:3px;font-weight:bold&quot;&gt;1&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Block Draft&lt;/b&gt;&lt;br&gt;&lt;br&gt;3-stage MTP 一次 draft forward&lt;br&gt;&lt;br&gt;产出一整块候选 tokens（block）&lt;br&gt;&lt;br&gt;同步物化 draft KV&lt;br&gt;&lt;br&gt;（fixed-shape，全 block 位置）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#6c8ebf;fontSize=11.5;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="255" height="280" as="geometry"/>
        </mxCell>

        <!-- Card 2: Markov Refine -->
        <mxCell id="card2" value="&lt;span style=&quot;background-color:#e07b1f;color:#ffffff;padding:1px 7px;border-radius:3px;font-weight:bold&quot;&gt;2&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Markov Refine&lt;/b&gt;&lt;br&gt;&lt;br&gt;对 block 做自回归 refine collective-free*：&lt;br&gt;•  embedding 每 rank 复制&lt;br&gt;•  logits 保持 vocab-sharded&lt;br&gt;•  每位置一次 tiny packed int64&lt;br&gt;    MAX all-reduce 求全局 argmax&lt;br&gt;&lt;br&gt;可被 draft CUDA graph 一起 capture&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8b8577&quot; style=&quot;font-size:10px&quot;&gt;*无 full-vocab collective，仅保留&lt;br&gt;  tiny MAX all-reduce&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#e8944a;fontSize=11;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="335" y="210" width="270" height="280" as="geometry"/>
        </mxCell>

        <!-- Card 3: Confidence Cap -->
        <mxCell id="card3" value="&lt;span style=&quot;background-color:#8c8578;color:#ffffff;padding:1px 7px;border-radius:3px;font-weight:bold&quot;&gt;3&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Confidence Cap&lt;/b&gt;&lt;br&gt;&lt;br&gt;confidence head 打分&lt;br&gt;&lt;br&gt;低于 threshold 截断降级&lt;br&gt;&lt;br&gt;threshold=0 时跳过" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#8c8578;fontSize=11.5;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="645" y="210" width="220" height="280" as="geometry"/>
        </mxCell>

        <!-- Card 4: Target Verify -->
        <mxCell id="card4" value="&lt;span style=&quot;background-color:#3d9a50;color:#ffffff;padding:1px 7px;border-radius:3px;font-weight:bold&quot;&gt;4&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Target Verify&lt;/b&gt;&lt;br&gt;&lt;br&gt;target 对整个 block 一次 verify&lt;br&gt;&lt;br&gt;greedy：无损，对齐 target&lt;br&gt;greedy 输出&lt;br&gt;&lt;br&gt;temperature&amp;gt;0：复用 target-only&lt;br&gt;rejection sampling&lt;br&gt;&lt;br&gt;TP 下由 rank0 broadcast&lt;br&gt;accept length / bonus token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#82b366;fontSize=11;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="905" y="210" width="250" height="280" as="geometry"/>
        </mxCell>

        <!-- Card 5: 输出 -->
        <mxCell id="card5" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;&lt;br&gt;accepted tokens&lt;br&gt;&lt;br&gt;bonus token&lt;br&gt;&lt;br&gt;更新后的 KV / 状态&lt;br&gt;&lt;br&gt;commit 后进入下一&lt;br&gt;decode step" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#8c8578;fontSize=11.5;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="210" width="225" height="280" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="card1" target="card2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="card2" target="card3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="card3" target="card4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1f3864;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="card4" target="card5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- (3) 关键设计点 -->
        <mxCell id="h3" value="&lt;b&gt;(3)　关键设计点&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="504" width="260" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="keys" value="&lt;font color=&quot;#3d9a50&quot;&gt;✔&lt;/font&gt;  每步提出 block，而不是逐 token draft&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3d9a50&quot;&gt;✔&lt;/font&gt;  refine 降低通信：full-vocab all-gather → tiny MAX all-reduce&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3d9a50&quot;&gt;✔&lt;/font&gt;  draft + refine 可进 CUDA graph，减少 launch 开销&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3d9a50&quot;&gt;✔&lt;/font&gt;  verify 保证正确性；采样路径也保持 TP 一致&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#3d9a50&quot;&gt;✔&lt;/font&gt;  默认 threshold=0 走最快路径" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;fontSize=12;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="534" width="640" height="186" as="geometry"/>
        </mxCell>

        <!-- Right summary panel -->
        <mxCell id="rsum" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;SGLang 中的 DSpark ＝ 用 target hidden 驱动的 block draft，&lt;br&gt;&lt;br&gt;再经 refine/cap 后由 target 验证提交。&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8b8577&quot; style=&quot;font-size:12px&quot;&gt;与 #29538：本图展开其 Worker 层单步执行细节&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0ede4;strokeColor=#b9b3a5;fontSize=13;fontColor=#1f3864;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="720" y="534" width="700" height="186" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
