<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="dspark-decode" name="Decode主流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="#30261 Decode 主流程: Propose -&gt; Schedule -&gt; Verify -&gt; Accept" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="980" height="36" as="geometry"/>
        </mxCell>

        <!-- ========== 输入 ========== -->
        <mxCell id="input" value="输入" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="in1" value="draft_input / bonus token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="input">
          <mxGeometry x="16" y="50" width="228" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="in2" value="当前 seq_lens / 序列状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="input">
          <mxGeometry x="16" y="106" width="228" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="in3" value="draft hidden / confidence 相关状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="input">
          <mxGeometry x="16" y="162" width="228" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="in4" value="gamma / verify_num_draft_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="input">
          <mxGeometry x="16" y="218" width="228" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="in_note" value="先提出候选 block，再按 confidence 决定 verify 多长;&#xa;draft 由 target hidden 驱动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="input">
          <mxGeometry x="16" y="280" width="228" height="110" as="geometry"/>
        </mxCell>

        <!-- ========== Decode 主流程 ========== -->
        <mxCell id="flow" value="Decode 主流程" style="swimlane;startSize=32;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="1000" height="420" as="geometry"/>
        </mxCell>

        <!-- Step 1 Propose -->
        <mxCell id="step1" value="1. DraftBlockProposer.propose&#xa;&#xa;生成候选 token blocks&#xa;→ draft_block / draft_tokens / draft_hidden&#xa;&#xa;可选 folded / cuda graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=8;fontSize=12;fontStyle=0;" vertex="1" parent="flow">
          <mxGeometry x="20" y="60" width="170" height="200" as="geometry"/>
        </mxCell>

        <!-- Planner group steps 2-4 -->
        <mxCell id="planner" value="Planner: confidence → budget → layout" style="swimlane;startSize=28;fillColor=#fff8f0;strokeColor=#d79b00;fontStyle=1;fontSize=12;rounded=1;arcSize=6;whiteSpace=wrap;html=1;swimlaneFillColor=#fff8f0;" vertex="1" parent="flow">
          <mxGeometry x="220" y="50" width="450" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="2. 计算 confidence&#xa;&#xa;proposal.confidence&#xa;或&#xa;DSparkVerifyPlanner.&#xa;compute_&#xa;confidence_tensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="planner">
          <mxGeometry x="16" y="44" width="132" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="3. 解析 verify budget&#xa;&#xa;DSparkVerifyPlanner.&#xa;resolve_verify_&#xa;token_budget&#xa;&#xa;confidence + SPS&#xa;cost table + 约束&#xa;→ verify token budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="planner">
          <mxGeometry x="160" y="44" width="132" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="4. schedule layout&#xa;&#xa;DSparkVerifyPlanner.&#xa;schedule_layout&#xa;&#xa;compact / ragged&#xa;决定各 request&#xa;的 verify 长度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="planner">
          <mxGeometry x="304" y="44" width="132" height="180" as="geometry"/>
        </mxCell>

        <!-- Step 5 Verify -->
        <mxCell id="step5" value="5. TargetVerifyExecutor.verify&#xa;&#xa;run_compact&#xa;或 run_non_compact&#xa;&#xa;target 执行验证&#xa;→ logits / hidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="flow">
          <mxGeometry x="700" y="60" width="130" height="200" as="geometry"/>
        </mxCell>

        <!-- Step 6 Accept -->
        <mxCell id="step6" value="6. accept / commit&#xa;&#xa;accept_and_finalize&#xa;&#xa;更新 draft KV&#xa;→ next_draft_input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0d4a8;strokeColor=#507e32;align=center;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="flow">
          <mxGeometry x="860" y="60" width="110" height="200" as="geometry"/>
        </mxCell>

        <!-- Flow edges -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flow" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="planner" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="planner" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flow" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="flow" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Phase labels under flow -->
        <mxCell id="ph1" value="Propose&#xa;提出候选" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="flow">
          <mxGeometry x="20" y="330" width="170" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="ph2" value="Schedule&#xa;confidence → budget → layout" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="flow">
          <mxGeometry x="220" y="330" width="450" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="ph3" value="Verify&#xa;target 验证" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="flow">
          <mxGeometry x="700" y="330" width="130" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="ph4" value="Accept&#xa;提交" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="flow">
          <mxGeometry x="860" y="330" width="110" height="44" as="geometry"/>
        </mxCell>

        <!-- Input → Flow arrow -->
        <mxCell id="e_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="input" target="flow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== 关键设计点 ========== -->
        <mxCell id="keys" value="关键设计点" style="swimlane;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;rounded=1;arcSize=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="80" width="300" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="key_list" value="• verify 长度不固定，按 confidence 调度&#xa;&#xa;• Planner 负责 budget + layout&#xa;　Executor 负责执行与 accept&#xa;&#xa;• 支持 compact / ragged verify 路径&#xa;&#xa;• idle / DP 场景仍可参与&#xa;&#xa;• propose / verify / accept&#xa;　全程可观测" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=12;whiteSpace=wrap;" vertex="1" parent="keys">
          <mxGeometry x="10" y="40" width="280" height="220" as="geometry"/>
        </mxCell>

        <!-- ========== 和总览图的对应关系 ========== -->
        <mxCell id="map" value="和总览图的对应关系" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="380" width="300" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="map_list" value="• Proposer：提出候选 blocks&#xa;&#xa;• Planner：决定 verify 长度&#xa;&#xa;• Executor：执行 verify 与 accept&#xa;&#xa;• Injector：维护 draft KV cache&#xa;&#xa;• Worker：编排以上组件" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=12;whiteSpace=wrap;" vertex="1" parent="map">
          <mxGeometry x="10" y="40" width="280" height="160" as="geometry"/>
        </mxCell>

        <!-- Bottom summary -->
        <mxCell id="summary" value="社区版 DSpark 的 decode 关键：不是 draft 完就验满，而是 propose 后按 confidence 调度 verify 窗口，再由 target 验证提交。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=16;spacingRight=16;fontSize=13;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1290" height="56" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="图例" style="swimlane;startSize=26;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=12;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="520" height="70" as="geometry"/>
