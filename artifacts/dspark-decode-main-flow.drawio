<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="dspark-decode" name="Decode主流程">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="#30261 Decode 主流程: Propose -&gt; Schedule -&gt; Verify -&gt; Accept" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="36" as="geometry"/>
        </mxCell>

        <!-- ========== (1) 输入 ========== -->
        <mxCell id="sec1" value="(1) 输入" style="swimlane;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1200" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="in1" value="draft_input / bonus token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sec1">
          <mxGeometry x="20" y="54" width="200" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="in2" value="当前 seq_lens / 序列状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sec1">
          <mxGeometry x="240" y="54" width="200" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="in3" value="draft hidden / confidence 相关状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sec1">
          <mxGeometry x="460" y="54" width="220" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="in4" value="gamma / verify_num_draft_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sec1">
          <mxGeometry x="700" y="54" width="220" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="in_note" value="先提出候选 block，再按 confidence 决定 verify 多长；&#xa;draft 由 target hidden 驱动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;spacingRight=8;fontSize=11;verticalAlign=middle;" vertex="1" parent="sec1">
          <mxGeometry x="20" y="114" width="900" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== (2) Decode 主流程 ========== -->
        <mxCell id="sec2" value="(2) Decode 主流程" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="1200" height="320" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="step1" value="1. DraftBlockProposer.propose&#xa;&#xa;生成候选 token blocks&#xa;→ draft_block&#xa;→ draft_tokens&#xa;→ draft_hidden&#xa;&#xa;可选 folded / cuda graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="sec2">
          <mxGeometry x="20" y="54" width="160" height="200" as="geometry"/>
        </mxCell>

        <!-- Planner group -->
        <mxCell id="planner" value="Planner: confidence → budget → layout" style="swimlane;startSize=28;fillColor=#fff8f0;strokeColor=#d79b00;fontStyle=1;fontSize=12;rounded=1;arcSize=4;whiteSpace=wrap;html=1;swimlaneFillColor=#fff8f0;" vertex="1" parent="sec2">
          <mxGeometry x="210" y="46" width="520" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="2. 计算 confidence&#xa;&#xa;来自&#xa;proposal.confidence&#xa;或&#xa;DSparkVerifyPlanner.&#xa;compute_confidence_tensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="planner">
          <mxGeometry x="16" y="40" width="150" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="3. 解析 verify budget&#xa;&#xa;DSparkVerifyPlanner.&#xa;resolve_verify_token_budget&#xa;&#xa;confidence + SPS&#xa;cost table + 约束&#xa;→ 本轮 verify&#xa;token budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="planner">
          <mxGeometry x="184" y="40" width="150" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="4. schedule layout&#xa;&#xa;DSparkVerifyPlanner.&#xa;schedule_layout&#xa;&#xa;compact / ragged&#xa;决定各 request&#xa;的 verify 长度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="planner">
          <mxGeometry x="352" y="40" width="150" height="170" as="geometry"/>
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="step5" value="5. TargetVerifyExecutor.verify&#xa;&#xa;run_compact&#xa;或 run_non_compact&#xa;&#xa;target 执行验证&#xa;→ logits / hidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="sec2">
          <mxGeometry x="760" y="54" width="180" height="200" as="geometry"/>
        </mxCell>

        <!-- Step 6 -->
        <mxCell id="step6" value="6. accept / commit&#xa;&#xa;accept_and_finalize&#xa;&#xa;更新 draft KV&#xa;→ next_draft_input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0d4a8;strokeColor=#507e32;align=center;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="sec2">
          <mxGeometry x="970" y="54" width="200" height="200" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sec2" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="planner" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="planner" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sec2" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sec2" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ========== (3) 关键设计点 ========== -->
        <mxCell id="sec3" value="(3) 关键设计点" style="swimlane;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1200" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="keys" value="关键设计点" style="swimlane;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="sec3">
          <mxGeometry x="20" y="50" width="560" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="key_list" value="• verify 长度不固定，按 confidence 调度&#xa;• Planner 负责 budget + layout，Executor 负责执行与 accept&#xa;• 支持 compact / ragged verify 路径&#xa;• idle / DP 场景仍可参与&#xa;• propose / verify / accept 全程可观测" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="keys">
          <mxGeometry x="12" y="36" width="536" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="map" value="和总览图的对应关系" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="sec3">
          <mxGeometry x="600" y="50" width="580" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="map_list" value="• Proposer：提出候选 blocks&#xa;• Planner：决定 verify 长度&#xa;• Executor：执行 verify 与 accept&#xa;• Injector：维护 draft KV cache&#xa;• Worker：编排以上组件" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="map">
          <mxGeometry x="12" y="36" width="556" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="summary" value="社区版 DSpark 的 decode 关键：不是 draft 完就验满，而是 propose 后按 confidence 调度 verify 窗口，再由 target 验证提交。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;spacingRight=12;fontSize=12;verticalAlign=middle;" vertex="1" parent="sec3">
          <mxGeometry x="20" y="206" width="1160" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
