<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0" type="device">
  <diagram id="dspark-pd" name="PD分离">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="650" math="0" shadow="0" background="#faf6ee">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;方案设计：DSpark 如何支持 PD（Prefill-Decode 分离）&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#16418c;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1380" height="38" as="geometry"/>
        </mxCell>

        <!-- (1) 核心思想 -->
        <mxCell id="p1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="920" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="p1_h" value="&lt;b&gt;(1)　核心思想&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="p1">
          <mxGeometry x="14" y="8" width="200" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="p1_box" value="–  DSpark draft 依赖 target fused hidden，而不是自己的 token KV&lt;br&gt;&lt;br&gt;–  PD 的目标：让 Decode 侧拿到足够状态，继续 DSpark propose / verify&lt;br&gt;&lt;br&gt;–  关键路径：Prefill 侧 bootstrap draft state，再通过 PD 传给 Decode&lt;br&gt;&lt;br&gt;–  关键约束：尽量复用现有 PD 数据面，不只靠跨 PD 传大量 hidden" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#9fb6dd;fontSize=12;fontColor=#16418c;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=10;" vertex="1" parent="p1">
          <mxGeometry x="18" y="40" width="884" height="118" as="geometry"/>
        </mxCell>

        <!-- (2) Prefill → PD → Decode 主流程 -->
        <mxCell id="p2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="246" width="920" height="286" as="geometry"/>
        </mxCell>
        <mxCell id="p2_h" value="&lt;b&gt;(2)　Prefill → PD → Decode 主流程&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="p2">
          <mxGeometry x="14" y="8" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="handoff" value="&lt;font color=&quot;#3d9a50&quot;&gt;Prefill handoff：&lt;/font&gt;&lt;font color=&quot;#16418c&quot;&gt;draft 状态在跨 PD 前准备好&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ed;strokeColor=#82b366;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="p2">
          <mxGeometry x="230" y="36" width="400" height="30" as="geometry"/>
        </mxCell>

        <!-- Prefill box -->
        <mxCell id="prefill" value="&lt;b&gt;&lt;font color=&quot;#2f5bb7&quot; style=&quot;font-size:12.5px&quot;&gt;Prefill 实例&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;1.  Target prefill forward&lt;br&gt;2.  捕获 last target hidden&lt;br&gt;3.  捕获 prefill_tail_hidden + prefill_tail_valid_mask&lt;br&gt;4.  Prefill 侧 bootstrap draft：&lt;br&gt;     由 target hidden 物化 draft KV / draft state&lt;br&gt;5.  准备 PD metadata：&lt;br&gt;     •  hidden_states&lt;br&gt;     •  prefill_tail_hidden_states&lt;br&gt;     •  prefill_tail_valid_mask" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=6;" vertex="1" parent="p2">
          <mxGeometry x="14" y="76" width="300" height="196" as="geometry"/>
        </mxCell>

        <!-- Middle PD transfer -->
        <mxCell id="pd_label" value="PD 传输" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f3864;" vertex="1" parent="p2">
          <mxGeometry x="340" y="80" width="240" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="pd_arrow" value="" style="endArrow=classic;html=1;strokeColor=#1f3864;strokeWidth=2;" edge="1" parent="p2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="116" as="sourcePoint"/>
            <mxPoint x="585" y="116" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="pd_txt" value="KV：target KV + draft KV（draft state）&#xa;Aux：hidden + prefill_tail(+mask)" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1f3864;" vertex="1" parent="p2">
          <mxGeometry x="336" y="126" width="250" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="pd_note" value="不是把完整推理上下文都甩给 Decode，&#xa;而是传 draft 启动所需最小状态&#xa;传的是启动所需的 last hidden / last window，&#xa;不是全量序列 hidden" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#8b8577;" vertex="1" parent="p2">
          <mxGeometry x="326" y="182" width="270" height="80" as="geometry"/>
        </mxCell>

        <!-- Decode box -->
        <mxCell id="decode" value="&lt;b&gt;&lt;font color=&quot;#3d9a50&quot; style=&quot;font-size:12.5px&quot;&gt;Decode 实例&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;1.  接收 KV + aux metadata&lt;br&gt;2.  build_dspark_disagg_draft_input(…)&lt;br&gt;3.  用 hidden / prefill_tail 重建 draft 启动上下文&lt;br&gt;     （对齐非 PD 路径的 draft 初始状态）&lt;br&gt;4.  进入正常 DSpark：draft → refine → verify&lt;br&gt;5.  后续 decode 轮次继续 speculative loop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10.5;fontColor=#1f3864;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=6;" vertex="1" parent="p2">
          <mxGeometry x="606" y="76" width="300" height="196" as="geometry"/>
        </mxCell>

        <!-- (3) 设计取舍 -->
        <mxCell id="p3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="980" y="58" width="440" height="474" as="geometry"/>
        </mxCell>
        <mxCell id="p3_h" value="&lt;b&gt;(3)　设计取舍 / 为什么这样做&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f3864;" vertex="1" parent="p3">
          <mxGeometry x="14" y="8" width="320" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="p3_1" value="&lt;font style=&quot;font-size:15px&quot;&gt;✅&lt;/font&gt;  Decode 不用重新完整 prefill draft" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="p3">
          <mxGeometry x="10" y="56" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3_2" value="&lt;font style=&quot;font-size:15px&quot;&gt;✅&lt;/font&gt;  复用现有 PD aux/metadata 通道" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="p3">
          <mxGeometry x="10" y="122" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3_3" value="&lt;font style=&quot;font-size:15px&quot;&gt;✅&lt;/font&gt;  propose / verify 主循环语义不变" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1f3864;spacingLeft=14;" vertex="1" parent="p3">
          <mxGeometry x="10" y="188" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3_note" value="注：空 batch / overlap 经 RelayPayload / FutureMap 兼容" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8b8577;spacingLeft=16;" vertex="1" parent="p3">
          <mxGeometry x="10" y="252" width="420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p3_scope" value="本图范围：PD handoff&#xa;不含：DP-attention 空 rank 协议 / PP context 累加" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#b9b3a5;fontSize=10.5;fontColor=#8b8577;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="p3">
          <mxGeometry x="18" y="380" width="404" height="66" as="geometry"/>
        </mxCell>

        <!-- Bottom summary -->
        <mxCell id="summary" value="&lt;b&gt;PD 支持的关键不是改 DSpark 算法，而是补齐 Prefill→Decode 的 draft 状态交接。&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f2ea;strokeColor=#b9b3a5;fontSize=15;fontColor=#1f3864;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="548" width="1380" height="54" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
